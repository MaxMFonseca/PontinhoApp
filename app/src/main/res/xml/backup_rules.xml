<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Captures live only in cacheDir/scans (cache is never backed up).
         Keep future non-cache scan locations excluded even if general rules change. -->
    <exclude domain="root" path="scans/" />
    <exclude domain="file" path="scans/" />
    <exclude domain="external" path="scans/" />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
